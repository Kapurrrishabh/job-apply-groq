# Optional. Groq keys are entered per person on the Settings page and stored encrypted, not here.
# The web UI listens on this machine only; run.py refuses any host other than 127.0.0.1 or localhost.
APP_HOST=127.0.0.1
APP_PORT=8000
# Where the database, resumes and encrypted logins live (default: ./instance).
# JOBAPPLY_INSTANCE=
# Encryption key for keys, logins and application history. Default: generated into instance/master.key on first run.
# JOBAPPLY_MASTER_KEY=
# 1 = run the app's browser without a window.
# JOBAPPLY_HEADLESS=0
